# DIT content rules, name forms and DIT structure rules (RFC 4512 4.1.6,
# 4.1.7) for the tree authnd publishes, under the example arc
# 1.3.6.1.4.1.99999. A test schema: not for production.
#
# ditcontentrule is slapd.conf(5)'s directive; slapd has none for name forms
# or structure rules, and nameform and ditstructurerule are go-authn/ldap's.

# An account (a person with no sn) may be a posixAccount, a shadowAccount
# and a uidObject -- not an ldapPublicKey -- and may not carry a description.
ditcontentrule ( 0.9.2342.19200300.100.4.5 NAME 'exampleAccountRule'
	AUX ( posixAccount $ shadowAccount $ uidObject )
	NOT description )

# An inetOrgPerson (a person with an sn) must have a telephone number.
ditcontentrule ( 2.16.840.1.113730.3.2.2 NAME 'examplePersonRule'
	AUX ( posixAccount $ uidObject $ ldapPublicKey )
	MUST telephoneNumber )

nameform ( 1.3.6.1.4.1.99999.9.1 NAME 'exampleDomainForm' OC domain MUST dc )
nameform ( 1.3.6.1.4.1.99999.9.2 NAME 'exampleUnitForm' OC organizationalUnit MUST ou )
nameform ( 1.3.6.1.4.1.99999.9.3 NAME 'exampleAccountForm' OC account MUST uid )
nameform ( 1.3.6.1.4.1.99999.9.4 NAME 'examplePersonForm' OC inetOrgPerson MUST uid )
nameform ( 1.3.6.1.4.1.99999.9.5 NAME 'examplePosixGroupForm' OC posixGroup MUST cn )

# The suffix, the containers under it, people and groups under those. Only
# posixGroups are placed: a group without a gidNumber (a groupOfNames) has no
# place in this tree.
ditstructurerule ( 1 NAME 'exampleSuffix' FORM exampleDomainForm )
ditstructurerule ( 2 NAME 'exampleUnit' FORM exampleUnitForm SUP 1 )
ditstructurerule ( 3 NAME 'exampleAccounts' FORM exampleAccountForm SUP 2 )
ditstructurerule ( 4 NAME 'examplePersons' FORM examplePersonForm SUP 2 )
ditstructurerule ( 5 NAME 'examplePosixGroups' FORM examplePosixGroupForm SUP 2 )
